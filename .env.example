# Copie este archivo a .env y complete los valores.
# El servicio no imprime estas variables.
# En systemd se cargan con EnvironmentFile, no desde este archivo.

HIKVISION_GATEWAY_PASSWORD=
# Token dedicado de Rancherito (settings.key = hikvision_integration_token).
# No es el token de impresión.
RANCHERITO_EVENTS_TOKEN=
